{
  "name": "brainbreak-motion-party",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "dev": "npm run build:wasm && vite --host 0.0.0.0",
    "build:web": "npm run build:wasm && vite build",
    "build": "npm run build:web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "voice:gen": "node scripts/generate-voice.mjs",
    "deploy": "npm run build && bash scripts/deploy-worker.sh",
    "dev:worker": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@tensorflow-models/pose-detection": "2.1.3",
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-backend-webgl": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@xyflow/react": "12.8.6",
    "jszip": "3.10.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260721.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "kokoro-js": "^1.2.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "wrangler": "4.112.0",
    "zod": "^4.4.3"
  }
}
